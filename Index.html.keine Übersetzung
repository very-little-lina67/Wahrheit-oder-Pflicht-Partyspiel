        // Placeholders that need translation (element id -> {de, en})
        const PLACEHOLDERS = {
            "feedback-text-input": {
                de: "Beschreibe den Bug oder deine Idee...",
                en: "Describe the bug or your idea..."
            },
            "friend-search-input": {
                de: "E-Mail oder Anzeigename...",
                en: "Email or display name..."
            },
            "lobby-code-input": {
                de: "Lobby-Code eingeben...",
                en: "Enter lobby code..."
            },
            "custom-task-input": {
                de: "Schreibe deine Frage oder Pflicht hier...",
                en: "Type your question or dare here..."
            },
            "player-answer-input": {
                de: "Schreibe deine Antwort hier...",
                en: "Type your answer here..."
            },
            "chat-input": {
                de: "Nachricht eingeben...",
                en: "Type a message..."
            },
            "auth-username": {
                de: "Dein Spielername",
                en: "Your Player Name"
            },
            "auth-password": {
                de: "Dein sicheres Passwort",
                en: "Your secure password"
            }
        };

        function applyLanguage(lang) {
            if (!I18N[lang]) lang = "de";
            const dict = I18N[lang];
            for (const id in dict) {
                const el = document.getElementById(id);
                if (el) el.textContent = dict[id];
            }
            // Placeholders
            for (const id in PLACEHOLDERS) {
                const el = document.getElementById(id);
                if (el && PLACEHOLDERS[id][lang]) {
                    el.placeholder = PLACEHOLDERS[id][lang];
                }
            }
            // Shop action buttons (class-based)
            const buyText = lang === "en" ? "Buy/Equip" : "Kaufen/Anlegen";
            const unlockText = lang === "en" ? "Unlock" : "Freischalten";
            document.querySelectorAll(".shop-action-btn").forEach(function (btn) {
                btn.textContent = buyText;
            });
            document.querySelectorAll(".theme-action-btn").forEach(function (btn) {
                btn.textContent = unlockText;
            });
            // Sync both language selects
            const authSel = document.getElementById("auth-lang-select");
            const appSel = document.getElementById("lang-select");
            if (authSel) authSel.value = lang;
            if (appSel) appSel.value = lang;
            document.documentElement.lang = lang;
            try { localStorage.setItem("tod_lang", lang); } catch (e) {}
        }

        // Public API – override / extend existing changeLanguage from app.js
        window.applyFullLanguage = applyLanguage;

        const _origChangeLanguage = typeof window.changeLanguage === "function" ? window.changeLanguage : null;
        const _origChangeLanguageFromApp = typeof window.changeLanguageFromApp === "function" ? window.changeLanguageFromApp : null;

        window.changeLanguage = function () {
            const sel = document.getElementById("auth-lang-select");
            const lang = sel ? sel.value : "de";
            if (_origChangeLanguage) {
                try { _origChangeLanguage(); } catch (e) {}
            }
            applyLanguage(lang);
        };

        window.changeLanguageFromApp = function () {
            const sel = document.getElementById("lang-select");
            const lang = sel ? sel.value : "de";
            if (_origChangeLanguageFromApp) {
                try { _origChangeLanguageFromApp(); } catch (e) {}
            }
            applyLanguage(lang);
        };

        // Apply on load (respect saved preference or current select)
        function initLang() {
            let lang = "de";
            try {
                const saved = localStorage.getItem("tod_lang");
                if (saved === "en" || saved === "de") lang = saved;
            } catch (e) {}
            const appSel = document.getElementById("lang-select");
            const authSel = document.getElementById("auth-lang-select");
            if (appSel && (appSel.value === "en" || appSel.value === "de")) lang = appSel.value;
            applyLanguage(lang);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initLang);
        } else {
            // app.js may load async; delay slightly so it can define its own handlers first
            setTimeout(initLang, 50);
        }
    })();
    </script>
