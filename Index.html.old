<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wahrheit oder Pflicht Partyspiel / Truth or Dare Party Game</title>
    
    <!-- Firebase SDKs (Compat-Modus für direkten Browser-Einsatz) -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <!-- Ausgelagertes Stylesheet für Themes, Layout & Komponenten -->
    <link rel="stylesheet" href="css/style.css">
</head>
<body class="theme-default">

    <!-- LOGIN & AUTH MODAL -->
    <div id="auth-modal" class="modal-overlay">
        <div class="modal-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h2 id="ui-auth-title" style="color: var(--primary-color); margin: 0; font-size: 1.2rem;">User Account & Vibe</h2>
                <div>
                    <select id="auth-lang-select" onchange="changeLanguage(this.value)" style="padding: 3px; font-size: 12px; width: auto; margin:0;">
                        <option value="de">🇩🇪 Deutsch</option>
                        <option value="en">🇬🇧 English</option>
                    </select>
                </div>
            </div>
            <p id="ui-auth-desc" style="font-size: 12px; color: #bbb; text-align: center; margin-bottom: 12px;">Log in to use your XP, coins and the shop!</p>
            
            <label id="ui-label-email" style="font-size: 12px; color: #ccc;">Email Address:</label>
            <input type="email" id="auth-email" placeholder="name@example.com">
            
            <label id="ui-label-username" style="font-size: 12px; color: #ccc; margin-top: 6px; display: block;">Username:</label>
            <input type="text" id="auth-username" placeholder="Your Player Name">

            <label id="ui-label-pass" style="font-size: 12px; color: #ccc; margin-top: 6px; display: block;">Password:</label>
            <input type="password" id="auth-password" placeholder="Your secure password">
            
            <div style="display: flex; gap: 8px; margin-top: 12px;">
                <button id="ui-btn-register" onclick="registerUser()" style="padding: 10px; font-size: 14px;">Register</button>
                <button id="ui-btn-login" onclick="loginUser()" style="padding: 10px; font-size: 14px;">Log In</button>
            </div>
        </div>
    </div>

    <!-- SHOP & PROFILE MODAL -->
    <div id="account-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h2 id="ui-shop-head" style="color: var(--accent-color); margin-top: 0; text-align: center; font-size: 1.2rem;">👤 Profile & Vibe Shop</h2>
            
            <div style="text-align: center; margin-bottom: 10px;">
                <div class="avatar-preview-box" id="avatar-display">😊<span id="equipped-accessory" class="acc-default"></span></div>
                <label id="ui-avatar-emote-label" for="avatar-emote-select" style="font-size:12px;color:#ccc;">🙂 Eigenes Emote / Avatar auswählen</label>
                <select id="avatar-emote-select" onchange="setAvatarEmote(this.value)" style="max-width:260px;margin:4px auto 8px;">
                    <option id="ui-emote-happy" value="😊">😊 Fröhlich</option><option id="ui-emote-excited" value="🤩">🤩 Begeistert</option><option id="ui-emote-party" value="🥳">🥳 Party</option><option id="ui-emote-cheeky" value="😈">😈 Frech</option><option id="ui-emote-robot" value="🤖">🤖 Roboter</option><option id="ui-emote-ghost" value="👻">👻 Geist</option><option id="ui-emote-cat" value="🐱">🐱 Katze</option><option id="ui-emote-fox" value="🦊">🦊 Fuchs</option><option id="ui-emote-frog" value="🐸">🐸 Frosch</option><option id="ui-emote-skull" value="💀">💀 Totenkopf</option><option id="ui-emote-fire" value="🔥">🔥 Feuer</option>
                </select>
                <strong id="acc-display-name" style="color: #ffcc00; font-size: 16px;"></strong> <span id="acc-display-role" style="background:#ff3300; padding:2px 5px; border-radius:4px; font-size:10px; font-weight:bold;"></span><br>
                <span id="acc-display-level" style="font-size: 12px; color: #00bfff;"></span> | 💰 <span id="acc-display-coins" style="color: #ffcc00;">0</span> <span id="ui-coins-text">Coins</span>
            </div>

            <div class="box-section" style="margin-top:0; padding:8px;">
                <h4 id="ui-badges-head" style="margin: 0 0 6px 0; color: var(--primary-color); font-size: 13px;">🏆 Your Badges & Trophies</h4>
                <div id="badge-container"></div>
            </div>

            <div class="box-section" style="padding:8px;">
                <h4 id="ui-accessories-head" style="margin: 0 0 6px 0; color: var(--accent-color); font-size: 13px;">🛍 Avatar Accessories</h4>
                <div class="shop-grid">
                    <div class="shop-item">
                        <div>👑 <span id="ui-item-crown">Crown</span> (150C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('crown', 150, '👑')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🕶️ <span id="ui-item-glasses">Sunglasses</span> (100C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('glasses', 100, '🕶️')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>✨ <span id="ui-item-sparkles">Sparkles</span> (60C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('sparkles', 60, '✨')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🎧 <span id="ui-item-headphones">Headphones</span> (90C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('headphones', 90, '🎧')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🎩 <span id="ui-item-hat">Party Hat</span> (120C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('hat', 120, '🎩')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🧔 <span id="ui-item-beard">Mustache</span> (80C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('beard', 80, '🧔')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🦄 <span id="ui-item-unicorn">Unicorn</span> (140C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('unicorn', 140, '🦄')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🧢 <span id="ui-item-cap">Cap</span> (70C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('cap', 70, '🧢')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🦋 <span id="ui-item-butterfly">Butterfly</span> (85C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('butterfly', 85, '🦋')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>💎 <span id="ui-item-diamond">Diamond</span> (200C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('diamond', 200, '💎')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🌈 <span id="ui-item-rainbow">Rainbow</span> (110C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('rainbow', 110, '🌈')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>⭐ <span id="ui-item-star">Star</span> (75C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('star', 75, '⭐')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🎭 <span id="ui-item-mask">Mask</span> (95C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('mask', 95, '🎭')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🌸 <span id="ui-item-flower">Flower</span> (65C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('flower', 65, '🌸')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🔥 <span id="ui-item-flame">Flame</span> (130C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('flame', 130, '🔥')">Buy/Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>👓 <span id="ui-item-cool">Brille</span> (115C)</div>
                        <button class="btn-blue shop-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyItem('cool', 115, '👓')">Buy/Equip</button>
                    </div>
                </div>
            </div>

            <div class="box-section" style="padding:8px;">
                <h4 id="ui-themes-head" style="margin: 0 0 6px 0; color: var(--primary-color); font-size: 13px;">🎨 Color Themes</h4>
                <div class="shop-grid">
                    <div class="shop-item">
                        <div><span id="ui-theme-cyberpunk">Cyberpunk</span> (200C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-cyberpunk', 200)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-retro">Retro-Pixel</span> (200C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-retro', 200)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-party">Party Neon</span> (180C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-party', 180)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-ocean">Ocean Wave</span> (180C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-ocean', 180)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-sunset">Sunset Glow</span> (160C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-sunset', 160)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-forest">Forest Green</span> (160C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-forest', 160)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-galaxy">Galaxy Night</span> (220C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-galaxy', 220)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-candy">Candy Pop</span> (150C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-candy', 150)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-midnight">Midnight</span> (190C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-midnight', 190)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-gold">Golden Hour</span> (250C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-gold', 250)">Unlock</button>
                    </div>

                    <div class="shop-item">
                        <div><span id="ui-theme-pikachu-warm">Pikachu & Ash (Warm)</span> (400C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-pikachu-warm', 400)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div><span id="ui-theme-pikachu-rain">Pikachu & Ash (Rain)</span> (400C)</div>
                        <button class="btn-green theme-action-btn" style="padding:5px; font-size:11px; margin-top:4px;" onclick="buyTheme('theme-pikachu-rain', 400)">Unlock</button>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 8px; margin-top: 12px;">
                <button id="ui-btn-logout" class="btn-danger" onclick="logoutUser()" style="flex: 1; padding: 8px; font-size: 13px;">Logout</button>
                <button id="ui-btn-close" class="btn-blue" onclick="closeAccountModal()" style="flex: 1; padding: 8px; font-size: 13px;">Close</button>
            </div>
        </div>
    </div>

    <!-- LEADERBOARD MODAL -->
    <div id="leaderboard-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h2 id="ui-lb-title" style="color: #ffcc00; margin-top:0; font-size: 1.2rem;">🏆 Rangliste</h2>
            <div style="display:flex; gap:6px; margin-bottom:10px;">
                <button id="lb-tab-global" class="btn-green" onclick="switchLeaderboardTab('global')" style="flex:1; padding:6px; font-size:12px;">🌍 Global</button>
                <button id="lb-tab-friends" class="btn-blue" onclick="switchLeaderboardTab('friends')" style="flex:1; padding:6px; font-size:12px;">👥 Freunde</button>
            </div>
            <p id="ui-lb-desc" style="font-size: 12px; color: #ccc;">Die Spieler mit den meisten Coins:</p>
            
            <div id="leaderboard-list" style="max-height: 280px; overflow-y: auto; margin-bottom: 12px;">
                <!-- Wird dynamisch gefüllt -->
            </div>

            <button id="ui-lb-close-btn" class="btn-blue" onclick="document.getElementById('leaderboard-modal').classList.add('hidden')" style="width: 100%; padding: 8px; font-size: 13px;">Schließen</button>
        </div>
    </div>

    <!-- ONLINE PLAYERS / INVITE MODAL -->
    <div id="online-players-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h2 id="ui-op-title" style="color: var(--accent-color); margin-top:0; font-size: 1.2rem;">🌐 Online Spieler & Einladungen</h2>
            <p id="ui-op-desc" style="font-size: 12px; color: #ccc;">Sieh, wer online ist, und lade Spieler in deine Lobby ein!</p>
            
            <div id="online-players-list" style="max-height: 220px; overflow-y: auto; margin-bottom: 12px;">
                <!-- Wird dynamisch gefüllt -->
            </div>

            <button id="ui-op-close-btn" class="btn-blue" onclick="document.getElementById('online-players-modal').classList.add('hidden')" style="width: 100%; padding: 8px; font-size: 13px;">Schließen</button>
        </div>
    </div>

    <!-- INCOMING INVITATION MODAL -->
    <div id="invite-modal" class="modal-overlay hidden">
        <div class="modal-content" style="text-align: center;">
            <h2 id="ui-invite-title" style="color: var(--primary-color); margin-top:0; font-size: 1.2rem;">📬 Spiel-Einladung!</h2>
            <p id="invite-msg-text" style="font-size: 14px; color: #fff; margin: 15px 0;"></p>
            
            <div style="display: flex; gap: 8px;">
                <button id="ui-invite-accept-btn" class="btn-green" onclick="acceptInvitation()" style="flex:1; padding: 10px; font-size: 14px;">Annehmen ✅</button>
                <button id="ui-invite-reject-btn" class="btn-danger" onclick="rejectInvitation()" style="flex:1; padding: 10px; font-size: 14px;">Ablehnen ❌</button>
            </div>
        </div>
    </div>

    <!-- FEEDBACK MODAL -->
    <div id="feedback-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h2 id="ui-fb-title" style="color: var(--primary-color); margin-top:0; font-size: 1.2rem;">📝 Bug melden / Feedback</h2>
            <p id="ui-fb-desc" style="font-size: 12px; color: #ccc;">Teile Bugs oder Verbesserungsvorschläge direkt mit!</p>
            
            <label id="ui-fb-type-label" style="font-size:12px; color:#ccc;">Art des Feedbacks:</label>
            <select id="feedback-type" style="font-size: 13px; padding: 8px;">
                <option value="bug" id="ui-fb-opt-bug">🐛 Bug / Fehler</option>
                <option value="improvement" id="ui-fb-opt-imp">💡 Verbesserung / Feature-Wunsch</option>
            </select>

            <label id="ui-fb-msg-label" style="font-size:12px; color:#ccc; margin-top:6px; display:block;">Nachricht:</label>
            <textarea id="feedback-text-input" rows="3" placeholder="Beschreibe den Bug oder deine Idee..." style="font-size: 13px;"></textarea>

            <div style="display: flex; gap: 8px; margin-top: 10px;">
                <button class="btn-green" onclick="submitFeedback()" id="ui-fb-send-btn" style="flex:1; padding: 8px; font-size: 13px;">Absenden</button>
                <button class="btn-blue" onclick="document.getElementById('feedback-modal').classList.add('hidden')" id="ui-fb-close-btn" style="flex:1; padding: 8px; font-size: 13px;">Schließen</button>
            </div>
        </div>
    </div>

    <!-- ADMIN PANEL MODAL -->
    <div id="admin-modal" class="modal-overlay hidden">
        <div class="modal-content" style="max-width: 500px;">
            <h2 id="ui-admin-title" style="color: #ff3300; margin-top:0; font-size: 1.2rem;">🛡️ Admin Panel</h2>
            <p id="ui-admin-desc" style="font-size: 12px; color: #ccc;">Verwalte Benutzer und Feedback.</p>
            
            <div class="box-section" style="max-height: 150px; overflow-y: auto; padding: 8px;">
                <h4 id="ui-admin-users-head" style="margin:0 0 6px 0; color:var(--accent-color); font-size: 12px;">👥 Benutzer:</h4>
                <div id="admin-user-list"></div>
            </div>

            <div class="box-section" style="max-height: 150px; overflow-y: auto; padding: 8px;">
                <h4 id="ui-admin-fb-head" style="margin:0 0 6px 0; color:var(--primary-color); font-size: 12px;">📥 Feedback:</h4>
                <div id="admin-feedback-list"></div>
            </div>

            <div style="margin-top: 10px;">
                <button id="ui-admin-close-btn" class="btn-blue" onclick="document.getElementById('admin-modal').classList.add('hidden')" style="width:100%; padding: 8px; font-size: 13px;">Schließen</button>
            </div>
        </div>
    </div>


    <!-- FRIENDS MODAL -->
    <div id="friends-modal" class="modal-overlay hidden">
        <div class="modal-content" style="max-width: 420px;">
            <h2 id="ui-friends-title" style="color: var(--accent-color); margin-top:0; font-size: 1.2rem;">👥 Freunde</h2>
            
            <div style="display:flex; gap:6px; margin-bottom:10px;">
                <button id="friends-tab-list" class="btn-blue" onclick="showFriendsTab('list')" style="flex:1; padding:6px; font-size:12px;"><span id="ui-friends-tab-list-text">Freundesliste</span></button>
                <button id="friends-tab-requests" class="btn-green" onclick="showFriendsTab('requests')" style="flex:1; padding:6px; font-size:12px;"><span id="ui-friends-tab-req-text">Anfragen</span> <span id="friend-req-badge" style="background:#ff0055;border-radius:10px;padding:1px 6px;font-size:10px;display:none;">0</span></button>
                <button id="friends-tab-add" class="btn-blue" onclick="showFriendsTab('add')" style="flex:1; padding:6px; font-size:12px;"><span id="ui-friends-tab-add-text">Hinzufügen</span></button>
            </div>

            <div id="friends-list-panel">
                <p id="ui-friends-list-desc" style="font-size:12px; color:#ccc; margin:0 0 8px 0;">Deine Freunde – online Status & Lobby-Einladung</p>
                <div id="friends-list" style="max-height: 260px; overflow-y: auto; margin-bottom: 10px;"></div>
            </div>

            <div id="friends-requests-panel" class="hidden">
                <p id="ui-friends-req-desc" style="font-size:12px; color:#ccc; margin:0 0 8px 0;">Eingehende Freundschaftsanfragen</p>
                <div id="friend-requests-list" style="max-height: 260px; overflow-y: auto; margin-bottom: 10px;"></div>
            </div>

            <div id="friends-add-panel" class="hidden">
                <p id="ui-friends-add-desc" style="font-size:12px; color:#ccc; margin:0 0 8px 0;">Freund per E-Mail oder Name suchen</p>
                <input type="text" id="friend-search-input" placeholder="E-Mail oder Anzeigename..." style="font-size:13px; padding:8px; margin-bottom:8px;">
                <button id="ui-friend-search-btn" class="btn-green" onclick="searchAndAddFriend()" style="width:100%; padding:8px; font-size:13px; margin-bottom:10px;">Suchen & Anfrage senden</button>
                <div id="friend-search-results" style="max-height: 180px; overflow-y: auto;"></div>
            </div>

            <button id="ui-friends-close-btn" class="btn-blue" onclick="document.getElementById('friends-modal').classList.add('hidden')" style="width:100%; padding:8px; font-size:13px;">Schließen</button>
        </div>
    </div>

    <div class="container">
        <!-- SPIELER HUD -->
        <div class="hud-bar">
            <div>🔥 <span id="ui-hud-streak-text">Streak</span>: <span id="hud-streak" style="color: #ffcc00; font-weight:bold;">0</span></div>
            <div>✨ XP: <span id="hud-xp" style="color: #00bfff; font-weight:bold;">0</span></div>
            <div>💰 <span id="ui-hud-coins-text">Coins</span>: <span id="hud-coins" style="color: #ffcc00; font-weight:bold;">0</span></div>
            <div style="display:flex; gap:3px; flex-wrap:wrap; width: 100%; justify-content: flex-end; margin-top: 4px;">
                <button id="btn-admin-panel" class="btn-danger hidden" onclick="openAdminModal()" style="padding:2px 5px; font-size:10px; width:auto; margin:0;">🛡️ Admin</button>
                <button id="ui-btn-leaderboard" class="btn-green" onclick="openLeaderboard()" style="padding:2px 5px; font-size:10px; width:auto; margin:0;">🏆 Rangliste</button>
                <button id="ui-btn-friends" class="btn-blue" onclick="openFriendsModal()" style="padding:2px 5px; font-size:10px; width:auto; margin:0;">👥 Freunde</button>
                <button id="ui-btn-players" class="btn-blue" onclick="openOnlinePlayersModal()" style="padding:2px 5px; font-size:10px; width:auto; margin:0;">🌐 Spieler</button>
                <button id="ui-btn-feedback" class="btn-green" onclick="openFeedbackModal()" style="padding:2px 5px; font-size:10px; width:auto; margin:0;">📝 Feedback</button>
                <button id="ui-btn-shop" class="btn-blue" onclick="openAccountModal()" style="padding:2px 5px; font-size:10px; width:auto; margin:0;">🛒 Shop</button>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <button id="leave-lobby-btn" class="btn-danger hidden" onclick="leaveLobby()" style="width: auto; padding: 5px 10px; font-size: 12px; margin: 0;">🚪 Lobby verlassen</button>
            
            <div style="margin-left: auto;">
                <label for="lang-select" style="font-size: 12px; color: #ccc;">🌐 <span id="ui-lang-label-text">Language</span>:</label>
                <select id="lang-select" onchange="changeLanguageFromApp(this.value)" style="width: auto; padding: 3px; font-size: 12px; display: inline-block;">
                    <option value="de">🇩🇪 Deutsch</option>
                    <option value="en">🇬🇧 English</option>
                </select>
            </div>
        </div>

        <h1 id="ui-title">Wahrheit oder Pflicht Partyspiel 🍻🚻</h1>
        <p id="ui-subtitle" style="font-size: 13px;">Spielt nacheinander Wahrheit oder Pflicht. Nach jeder Runde dreht sich das Rad!</p>

        <!-- SETUP (LOBBY) -->
        <div id="setup" class="box-section hidden">
            <h3 id="ui-setup-head" style="font-size: 14px; margin-top: 0;">Online Lobby:</h3>
            <p id="ui-private-lobby-hint" style="font-size:11px; color:#aaa; margin:4px 0 8px 0;">🔑 Teile den Lobby-Code mit deinen Freunden oder lade sie direkt ein.</p>
            <button onclick="hostGame()" id="ui-host-btn" style="margin-top: 4px; font-size: 14px; padding: 10px;">Lobby erstellen (Host) 🏠</button>
            <hr style="border-color: rgba(255,255,255,0.1); margin: 10px 0;">
            <input type="text" id="lobby-code-input" placeholder="Lobby-Code eingeben..." style="font-size: 14px; padding: 10px;">
            <button class="btn-blue" onclick="joinGame()" id="ui-join-btn" style="font-size: 14px; padding: 10px;">Lobby beitreten 🚀</button>
        </div>

        <!-- LOBBY WARTESAAL -->
        <div id="lobby-wait-box" class="hidden box-section" style="text-align: center;">
            <h3 id="ui-lobby-code-title" style="font-size: 14px;">Lobby Code: <span id="display-code" style="color: #ffcc00; font-size: 18px;"></span></h3>
            <p id="ui-share-code" style="font-size: 12px;">Teile diesen Code mit deinen Mitspielern!</p>
            <ul id="player-list" style="list-style: none; padding: 0; text-align: left; font-size: 13px;"></ul>
            <button id="start-btn" class="hidden" onclick="startOnlineGame()" style="font-size: 14px; padding: 10px;">Spiel starten! 🔥</button>
            <div id="client-wait-msg" class="hidden" style="color: #ffcc00; font-size: 12px;">Mit Lobby verbunden! Warte darauf, dass der Host startet...</div>
        </div>

        <!-- WAHRHEIT ODER PFLICHT PHASE -->
        <div id="woP-phase" class="hidden">
            <h2 id="wop-turn-title" style="font-size: 1.2rem;">Current Turn: </h2>
            
            <div class="box-section" id="wop-choice-area">
                <label id="ui-choice-label" style="font-size: 13px;">What do you choose?</label>
                <select id="wop-choice" style="font-size: 13px; padding: 8px;">
                    <option value="truth" id="ui-opt-truth">Truth (+XP / +4 Coins)</option>
                    <option value="dare" id="ui-opt-dare">Dare (+XP / +8 Coins)</option>
                </select>
                <div>
                    <button onclick="submitWopChoice()" id="ui-select-btn" style="width: 100%; font-size: 14px; padding: 10px;">Select 🎲</button>
                </div>
            </div>

            <div class="box-section hidden" id="creator-input-area" style="border-left-color: #ffcc00;">
                <h3 id="creator-instruction-title" style="color: #ffcc00; font-size: 14px; margin-top:0;"></h3>
                <p id="creator-target-info" style="font-size: 12px; color: #ccc;"></p>
                <input type="text" id="custom-task-input" placeholder="Type your question or dare here..." style="font-size: 13px; padding: 8px;">
                <button class="btn-blue" onclick="sendCustomTask()" id="ui-send-task-btn" style="font-size: 13px; padding: 8px;">Send to player 🚀</button>
            </div>

            <div class="box-section hidden" id="active-task-area" style="border-left-color: var(--accent-color);">
                <h3 id="task-title-text" style="color: var(--accent-color); font-size: 14px; margin-top:0;"></h3>
                <p style="font-size: 12px; color: #ffcc00;" id="task-assigner-info"></p>
                <p id="task-content-desc" style="font-size: 15px; font-weight: bold; background: rgba(0,0,0,0.3); padding: 8px; border-radius: 6px;"></p>
                
                <div id="answer-box" class="hidden" style="margin-top: 8px;">
                    <label id="ui-answer-label" style="font-size: 12px;">Your Answer:</label>
                    <textarea id="player-answer-input" rows="2" placeholder="Type your answer here..." style="font-size: 13px;"></textarea>
                    <button class="btn-green" onclick="submitAnswer()" style="margin-top: 6px; font-size: 13px; padding: 8px;" id="ui-submit-answer-btn">✅ Submit Answer</button>
                </div>

                <div id="dare-box" class="hidden" style="margin-top: 8px;">
                    <button class="btn-green" onclick="submitDareDone()" style="margin-top: 6px; font-size: 13px; padding: 8px;" id="ui-dare-done-btn">✅ Dare completed & confirm!</button>
                </div>
            </div>

            <div class="box-section hidden" id="result-feedback-area" style="border-left-color: #28a745; text-align: center;">
                <h3 id="ui-done-head" style="color: #28a745; font-size: 14px; margin-top:0;">🎉 Done!</h3>
                <p id="feedback-player-name" style="font-weight: bold; font-size: 14px; color: #ffcc00;"></p>
                <p id="feedback-task-info" style="font-style: italic; color: #ccc; font-size: 12px;"></p>
                <div id="feedback-result-box" style="background: rgba(0,0,0,0.4); padding: 10px; border-radius: 8px; font-size: 15px; margin: 8px 0;"></div>
                
                <button class="btn-blue" id="next-turn-btn" disabled onclick="voteNextTurn()" style="margin-top: 8px; font-size: 13px; padding: 8px;">✅ Ich bestätige</button>
                <p id="waiting-next-msg" style="color: var(--accent-color); font-size: 12px; margin-top: 6px;"><span id="ui-waiting-other">Warte auf die Bestätigungen aller aktiven Spieler…</span> (<span id="next-votes-count">0</span>/<span id="next-votes-total">0</span>)</p>
            </div>

            <div class="box-section hidden" id="waiting-for-player-box" style="border-left-color: #666;">
                <p id="waiting-info-text" style="color: #ccc; font-weight: bold; font-size: 13px; margin:0;"></p>
            </div>

            <div id="wop-status-info" style="margin-top: 10px; font-size: 13px; color: #ffcc00;"></div>
        </div>

        <!-- GLÜCKSRAD -->
        <div id="wheel-phase" class="hidden">
            <h2 id="ui-wheel-head" style="color: var(--accent-color); font-size: 1.2rem;">🎡 WHEEL MODE: Everyone acts!</h2>
            <p id="ui-wheel-desc" style="font-size: 12px;">Everyone played truth or dare. Now the wheel spins for everyone!</p>
            
            <div class="pointer"></div>
            <div id="wheel-container">Wheel ready!</div>
            
            <button onclick="spinWheel()" id="spin-btn" class="btn-blue" style="font-size: 14px; padding: 10px;">Spin the wheel now 🎡</button>
            
            <div id="wheel-result-box" class="box-section hidden" style="border-left-color: var(--accent-color); text-align: center;">
                <h3 id="wheel-action-title" style="color: #ffcc00; font-size: 14px; margin-top:0;"></h3>
                <p id="wheel-action-desc" style="font-size: 12px;"></p>
                
                <button id="next-round-btn" onclick="voteNextRound()" class="btn-blue" style="margin-top: 8px; font-size: 13px; padding: 8px;">➡️ Next Round!</button>
                <p id="waiting-round-msg" style="color: var(--accent-color); font-size: 12px; margin-top: 6px;"><span id="ui-waiting-other-round">Warte auf die Bestätigungen der anderen Spieler...</span> (<span id="round-votes-count">0</span>/<span id="round-votes-total">0</span>)</p>
            </div>
        </div>

        <!-- LIVE CHAT BEREICH -->
        <div id="chat-box-container" class="hidden">
            <div id="chat-messages"></div>
            <div style="display: flex; gap: 5px;">
                <input type="text" id="chat-input" placeholder="Type a message..." style="margin:0; font-size: 13px; padding: 8px;" onkeydown="if(event.key === 'Enter') sendChatMessage()">
                <button class="btn-blue" style="width: 70px; margin:0; padding:8px; font-size: 12px;" onclick="sendChatMessage()" id="ui-chat-send">Send</button>
            </div>
        </div>

        <!-- NOTFALL BUTTON -->
        <div id="emergency-box" class="hidden" style="margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 10px;">
            <p id="ui-emergency-desc" style="font-size: 12px; color: #ff9999;">Anyone who caves or leaks loses immediately!</p>
            <button onclick="triggerLeak()" class="btn-danger" id="ui-leak-btn" style="font-size: 12px; padding: 8px;">🚨 I leaked / had to pee (Lost!)</button>
        </div>

        <!-- Rechtliche Links -->
        <div id="legal-footer" style="margin-top: 24px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.15); text-align: center; font-size: 12px;">
            <a id="ui-footer-imprint" href="impressum.html" style="color: #00bfff; text-decoration: none; margin: 0 8px;">Impressum</a>
            <span style="color: #666;">·</span>
            <a id="ui-footer-privacy" href="datenschutz.html" style="color: #00bfff; text-decoration: none; margin: 0 8px;">Datenschutz</a>
        </div>
    </div>

    <!-- Ausgelagerte Spiellogik, Firebase-Sync & Client-Interaktionen -->
    <script src="js/app.js"></script>
</body>
</html>
