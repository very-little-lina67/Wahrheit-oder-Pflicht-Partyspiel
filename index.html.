        // --- PERSISTENTES SYSTEM (LOCALSTORAGE - BLEIBT BEI UPDATES ERHALTEN) ---
        let myName = "";
        let myEmail = "";
        let myRole = "user";
        let userXP = 0;
        let userCoins = 0;
        let userStreak = 0;
        let userLevel = 1;
        let equippedAccessory = "";
        let unlockedItems = [];
        let unlockedBadges = [];
        let truthCount = 0;
        let dareCount = 0;

        function getGlobalUsers() {
            return JSON.parse(localStorage.getItem("wop_users_global_v5") || "{}");
        }
        function saveGlobalUsers(users) {
            localStorage.setItem("wop_users_global_v5", JSON.stringify(users));
        }

        function getGlobalFeedback() {
            return JSON.parse(localStorage.getItem("wop_feedback_global_v5") || "[]");
        }
        function saveGlobalFeedback(fbList) {
            localStorage.setItem("wop_feedback_global_v5", JSON.stringify(fbList));
        }

        // Master-Account automatischer Fix bei jedem Start (Persistenz-Garantie)
        function ensureMasterAccountExists() {
            let users = getGlobalUsers();
            if (!users["master@vibe.party"]) {
                users["master@vibe.party"] = { name: "MasterAdmin", pass: "master1234", role: "master" };
                saveGlobalUsers(users);
            } else {
                users["master@vibe.party"].role = "master"; // Erzwinge Master-Status
                saveGlobalUsers(users);
            }
        }

        function loadUserData() {
            if (!myEmail) return;
            ensureMasterAccountExists();

            let users = getGlobalUsers();
            if (myEmail === "master@vibe.party") {
                myRole = "master";
            } else if (users[myEmail] && users[myEmail].role) {
                myRole = users[myEmail].role;
            } else {
                myRole = "user";
            }

            let dataKey = "wop_profile_v5_" + myEmail;
            let pData = JSON.parse(localStorage.getItem(dataKey) || "{}");
            userXP = pData.xp || 0;
            userCoins = pData.coins || 50; 
            userStreak = pData.streak || 0;
            equippedAccessory = pData.accessory || "";
            unlockedItems = pData.items || [];
            unlockedBadges = pData.badges || [];
            truthCount = pData.truthCount || 0;
            dareCount = pData.dareCount || 0;
            
            calculateLevel();
            updateHUD();
            updateProfileModal();
            checkAdminPermissions();
            if (pData.theme) setTheme(pData.theme);
        }

        function saveUserData() {
            if (!myEmail) return;
            let dataKey = "wop_profile_v5_" + myEmail;
            let pData = {
                xp: userXP,
                coins: userCoins,
                streak: userStreak,
                accessory: equippedAccessory,
                items: unlockedItems,
                badges: unlockedBadges,
                truthCount: truthCount,
                dareCount: dareCount,
                theme: document.body.className
            };
            localStorage.setItem(dataKey, JSON.stringify(pData));
        }

        function calculateLevel() {
            userLevel = Math.floor(userXP / 100) + 1;
        }

        function updateHUD() {
            document.getElementById("hud-streak").innerText = userStreak;
            document.getElementById("hud-xp").innerText = userXP;
            document.getElementById("hud-coins").innerText = userCoins;
        }

        function checkAdminPermissions() {
            let adminBtn = document.getElementById("btn-admin-panel");
            if (myRole === "master" || myRole === "admin" || myRole === "moderator") {
                adminBtn.classList.remove("hidden");
            } else {
                adminBtn.classList.add("hidden");
            }
        }

        function updateProfileModal() {
            document.getElementById("acc-display-name").innerText = myName;
            let roleBadge = document.getElementById("acc-display-role");
            roleBadge.innerText = myRole.toUpperCase();
            if(myRole === "master") roleBadge.style.background = "#ff0055";
            else if(myRole === "admin") roleBadge.style.background = "#ff3300";
            else if(myRole === "moderator") roleBadge.style.background = "#00bfff";
            else roleBadge.style.background = "#666";

            document.getElementById("acc-display-level").innerText = (currentLang === 'de' ? `Partystufe ${userLevel} (${userXP} XP)` : `Party Level ${userLevel} (${userXP} XP)`);
            document.getElementById("acc-display-coins").innerText = userCoins;
            document.getElementById("equipped-accessory").innerText = equippedAccessory;
            
            let badgeBox = document.getElementById("badge-container");
            badgeBox.innerHTML = unlockedBadges.length > 0 ? "" : `<span style='font-size:12px; color:#888;'>${currentLang === 'de' ? 'Noch keine Badges freigeschaltet.' : 'No badges unlocked yet.'}</span>`;
            unlockedBadges.forEach(b => {
                badgeBox.innerHTML += `<span class="badge-tag">${b}</span>`;
            });
        }

        function addRewards(isDare) {
            let mult = userStreak >= 5 ? 2 : 1;
            let xpGain = isDare ? 30 : 15;
            let coinGain = (isDare ? 20 : 10) * mult;

            userXP += xpGain;
            userCoins += coinGain;
            userStreak++;
            
            if(isDare) dareCount++;
            else truthCount++;

            checkBadges();
            calculateLevel();
            updateHUD();
            saveUserData();
        }

        function checkBadges() {
            if (dareCount >= 10 && !unlockedBadges.includes("🔥 Muttermal (10 Pflichten)")) {
                unlockedBadges.push("🔥 Muttermal (10 Pflichten)");
            }
            if (truthCount >= 10 && !unlockedBadges.includes("💡 Wahrheitsfanatiker")) {
                unlockedBadges.push("💡 Wahrheitsfanatiker");
            }
            if (userStreak >= 5 && !unlockedBadges.includes("⚡ Streak-Monster")) {
                unlockedBadges.push("⚡ Streak-Monster");
            }
        }

        function buyItem(itemKey, cost, symbol) {
            if (unlockedItems.includes(itemKey)) {
                equippedAccessory = (equippedAccessory === symbol) ? "" : symbol;
            } else {
                if (userCoins >= cost) {
                    userCoins -= cost;
                    unlockedItems.push(itemKey);
                    equippedAccessory = symbol;
                    alert(currentLang === 'de' ? "Erfolgreich gekauft und ausgerüstet!" : "Successfully purchased and equipped!");
                } else {
                    alert(currentLang === 'de' ? "Nicht genug Coins!" : "Not enough coins!");
                }
            }
            saveUserData();
            updateProfileModal();
        }

        function buyTheme(themeName, cost) {
            if (userCoins >= cost) {
                userCoins -= cost;
                setTheme(themeName);
                alert(currentLang === 'de' ? "Theme freigeschaltet und angewendet!" : "Theme unlocked and applied!");
                saveUserData();
                updateProfileModal();
            } else {
                alert(currentLang === 'de' ? "Nicht genug Coins!" : "Not enough coins!");
            }
        }

        function setTheme(className) {
            document.body.className = className;
        }

        // AUTH LOGIK
        window.addEventListener("DOMContentLoaded", () => {
            ensureMasterAccountExists();
            const savedEmail = localStorage.getItem("wop_user_email_v5");
            const savedName = localStorage.getItem("wop_user_name_v5");
            if (savedEmail && savedName) {
                myEmail = savedEmail;
                myName = savedName;
                showLoggedInState();
            }
            changeLanguage();
        });

        function registerUser() {
            const email = document.getElementById("auth-email").value.trim().toLowerCase();
            const username = document.getElementById("auth-username").value.trim();
            const password = document.getElementById("auth-password").value.trim();
            if (!email || !username || !password) { alert(translations[currentLang].alertEmailNamePass); return; }

            let users = getGlobalUsers();
            if (users[email]) { alert(translations[currentLang].alertAccountExists); return; }

            let assignedRole = (email === "master@vibe.party") ? "master" : "user";

            users[email] = { name: username, pass: password, role: assignedRole };
            saveGlobalUsers(users);
            
            myEmail = email;
            myName = username;
            myRole = assignedRole;
            localStorage.setItem("wop_user_email_v5", myEmail);
            localStorage.setItem("wop_user_name_v5", myName);

            loadUserData();
            alert(translations[currentLang].alertRegistered);
            showLoggedInState();
        }

        function loginUser() {
            const email = document.getElementById("auth-email").value.trim().toLowerCase();
            const username = document.getElementById("auth-username").value.trim();
            const password = document.getElementById("auth-password").value.trim();
            if (!email || !username || !password) { alert(translations[currentLang].alertEmailNamePass); return; }

            ensureMasterAccountExists();
            let users = getGlobalUsers();

            if (users[email] && users[email].name.toLowerCase() === username.toLowerCase() && users[email].pass === password) {
                myEmail = email;
                myName = users[email].name;
                myRole = users[email].role || "user";
                if(email === "master@vibe.party") myRole = "master";

                localStorage.setItem("wop_user_email_v5", myEmail);
                localStorage.setItem("wop_user_name_v5", myName);
                loadUserData();
                showLoggedInState();
            } else {
                alert(translations[currentLang].alertNoAccount);
            }
        }

        function logoutUser() {
            localStorage.removeItem("wop_user_email_v5");
            localStorage.removeItem("wop_user_name_v5");
            myEmail = ""; myName = ""; myRole = "user";
            document.getElementById("account-modal").classList.add("hidden");
            document.getElementById("auth-modal").classList.remove("hidden");
            document.getElementById("setup").classList.add("hidden");
        }

        function showLoggedInState() {
            document.getElementById("auth-modal").classList.add("hidden");
            document.getElementById("account-modal").classList.add("hidden");
            document.getElementById("setup").classList.remove("hidden");
            loadUserData();
        }

        function openAccountModal() {
            updateProfileModal();
            document.getElementById("account-modal").classList.remove("hidden");
        }
        function closeAccountModal() {
            document.getElementById("account-modal").classList.add("hidden");
        }

        function openFeedbackModal() {
            document.getElementById("feedback-text-input").value = "";
            document.getElementById("feedback-modal").classList.remove("hidden");
        }

        function submitFeedback() {
            let type = document.getElementById("feedback-type").value;
            let text = document.getElementById("feedback-text-input").value.trim();
            if (!text) { alert(translations[currentLang].alertFeedbackEmpty); return; }

            let fbList = getGlobalFeedback();
            fbList.push({
                author: myName,
                email: myEmail,
                type: type,
                text: text,
                date: new Date().toLocaleString()
            });
            saveGlobalFeedback(fbList);

            document.getElementById("feedback-modal").classList.add("hidden");
            alert(translations[currentLang].alertFeedbackSuccess);
        }

        function openAdminModal() {
            if (myRole !== "master" && myRole !== "admin" && myRole !== "moderator") {
                alert("Keine Berechtigung!");
                return;
            }
            renderAdminUserList();
            renderAdminFeedbackList();
            document.getElementById("admin-modal").classList.remove("hidden");
        }

        function renderAdminUserList() {
            ensureMasterAccountExists();
            let users = getGlobalUsers();
            let container = document.getElementById("admin-user-list");
            container.innerHTML = "";

            for (let email in users) {
                let u = users[email];
                let isMasterAccount = (email === "master@vibe.party" || u.role === "master");
                
                let html = `<div style="background:rgba(255,255,255,0.05); padding:8px; border-radius:6px; margin-bottom:6px; display:flex; justify-content:space-between; align-items:center; font-size:13px;">
                    <div><b>${u.name}</b> (${email}) <br><span style="color:#00bfff;">Rolle: ${u.role || 'user'}</span></div>`;
                
                if (myRole === "master" && !isMasterAccount) {
                    html += `<div>
                        <select onchange="changeUserRole('${email}', this.value)" style="padding:4px; font-size:12px; width:auto; margin:0;">
                            <option value="user" ${u.role==='user'?'selected':''}>User</option>
                            <option value="moderator" ${u.role==='moderator'?'selected':''}>Moderator</option>
                            <option value="admin" ${u.role==='admin'?'selected':''}>Admin</option>
                        </select>
                        <button class="btn-danger" style="padding:4px 8px; font-size:11px; margin:0;" onclick="deleteUser('${email}')">Löschen</button>
                    </div>`;
                } else if (isMasterAccount) {
                    html += `<span style="color:#ff0055; font-weight:bold;">👑 Master</span>`;
                } else {
                    html += `<span style="color:#888; font-size:11px;">Nur Master</span>`;
                }

                html += `</div>`;
                container.innerHTML += html;
            }
        }

        function renderAdminFeedbackList() {
            let fbList = getGlobalFeedback();
            let container = document.getElementById("admin-feedback-list");
            container.innerHTML = "";

            if (fbList.length === 0) {
                container.innerHTML = `<span style="font-size:12px; color:#888;">Kein Feedback vorhanden.</span>`;
                return;
            }

            fbList.forEach((fb, idx) => {
                let typeColor = fb.type === 'bug' ? '#ff3300' : '#00bfff';
                container.innerHTML += `<div style="background:rgba(255,255,255,0.05); padding:8px; border-radius:6px; margin-bottom:6px; font-size:13px; border-left:4px solid ${typeColor};">
                    <div><b>${fb.author}</b> (${fb.email}) - <span style="color:${typeColor}; font-weight:bold;">${fb.type.toUpperCase()}</span> <span style="font-size:11px; color:#aaa;">(${fb.date})</span></div>
                    <div style="margin-top:4px; color:#fff;">${fb.text}</div>
                    ${myRole === 'master' || myRole === 'admin' ? `<button class="btn-danger" style="padding:2px 6px; font-size:10px; margin-top:5px;" onclick="deleteFeedback(${idx})">Löschen</button>` : ''}
                </div>`;
            });
        }

        function changeUserRole(email, newRole) {
            if (myRole !== "master") {
                alert("Nur der Master-Account darf Rollen ändern!");
                renderAdminUserList();
                return;
            }
            let users = getGlobalUsers();
            if (users[email]) {
                users[email].role = newRole;
                saveGlobalUsers(users);
                renderAdminUserList();
            }
        }

        function deleteUser(email) {
            if (myRole !== "master") {
                alert("Nur der Master-Account darf Benutzer löschen!");
                return;
            }
            if (email === "master@vibe.party") {
                alert("Der Master-Account kann nicht gelöscht werden!");
                return;
            }
            let users = getGlobalUsers();
            if (users[email]) {
                delete users[email];
                saveGlobalUsers(users);
                localStorage.removeItem("wop_profile_v5_" + email);
                renderAdminUserList();
            }
        }

        function deleteFeedback(idx) {
            let fbList = getGlobalFeedback();
            fbList.splice(idx, 1);
            saveGlobalFeedback(fbList);
            renderAdminFeedbackList();
        }

        function useJoker() {
            if (userCoins >= 30) {
                userCoins -= 30;
                saveUserData();
                updateHUD();
                alert(currentLang === 'de' ? "🃏 Joker eingesetzt! Du hast diese Aufgabe übersprungen und darfst weiter mitspielen." : "🃏 Joker used! You skipped this task and can keep playing.");
                currentPlayerIndex++;
                updateWopTurn();
            } else {
                alert(currentLang === 'de' ? "Nicht genug Coins für einen Joker (Kosten: 30 Coins)!" : "Not enough coins for a joker (Cost: 30 coins)!");
            }
        }

        // --- NETZWERK & PEERJS SPIEL-LOGIK ---
        let peer = null;
        let hostConnection = null;
        let clientConnections = [];
        let isHost = false;
        let players = [];
        let currentPlayerIndex = 0;
        let pendingChoice = "";
        let currentTaskText = "";
        let currentRotation = 0;
        let nextTurnVotedPlayers = [];
        let nextRoundVotedPlayers = [];
        let activeLobbyCode = "";

        function hostGame() {
            isHost = true;
            activeLobbyCode = "vibe" + Math.floor(1000 + Math.random() * 9000);
            
            peer = new Peer(activeLobbyCode, { host: '0.peerjs.com', port: 443, secure: true });

            peer.on('open', (id) => {
                players = [{ name: myName, accessory: equippedAccessory, eliminated: false }];
                document.getElementById("setup").classList.add("hidden");
                document.getElementById("lobby-wait-box").classList.remove("hidden");
                document.getElementById("display-code").innerText = activeLobbyCode.toUpperCase();
                document.getElementById("start-btn").classList.remove("hidden");
                updatePlayerList();
            });

            peer.on('connection', (incomingConn) => {
                clientConnections.push(incomingConn);
                setupHostConnectionEvents(incomingConn);
            });
        }

        function joinGame() {
            const rawCode = document.getElementById("lobby-code-input").value.trim();
            const code = rawCode.toLowerCase();
            if (!rawCode) { alert(translations[currentLang].alertNameCode); return; }
            isHost = false;

            peer = new Peer({ host: '0.peerjs.com', port: 443, secure: true });

            peer.on('open', () => {
                hostConnection = peer.connect(code, { reliable: true });
                hostConnection.on('open', () => {
                    setupClientConnectionEvents(hostConnection);
                    hostConnection.send({ type: 'JOIN', name: myName, accessory: equippedAccessory });
                    
                    document.getElementById("setup").classList.add("hidden");
                    document.getElementById("lobby-wait-box").classList.remove("hidden");
                    document.getElementById("display-code").innerText = rawCode.toUpperCase();
                    document.getElementById("client-wait-msg").classList.remove("hidden");
                });
            });
        }

        function sendData(data) {
            if (isHost) {
                handleIncomingData(data);
                clientConnections.forEach(c => { if(c && c.open) c.send(data); });
            } else {
                if (data.type === 'CHAT_MSG') handleIncomingData(data);
                if(hostConnection && hostConnection.open) hostConnection.send(data);
            }
        }

        function setupHostConnectionEvents(c) {
            c.on('data', (data) => {
                if (data.type === 'JOIN') {
                    if (!players.some(p => p.name === data.name)) {
                        players.push({ name: data.name, accessory: data.accessory, eliminated: false });
                        let updateMsg = { type: 'UPDATE_PLAYERS', players: players };
                        updatePlayerList();
                        clientConnections.forEach(conn => conn.send(updateMsg));
                    }
                } else {
                    handleIncomingData(data);
                    clientConnections.forEach(conn => { if(conn !== c && conn.open) conn.send(data); });
                }
            });
        }

        function setupClientConnectionEvents(c) {
            c.on('data', (data) => { handleIncomingData(data); });
        }

        function handleIncomingData(data) {
            if (data.type === 'UPDATE_PLAYERS') {
                players = data.players;
                updatePlayerList();
            } else if (data.type === 'START_GAME') {
                players = data.players;
                startGameUI();
            } else if (data.type === 'SUBMIT_CHOICE') {
                pendingChoice = data.choice;
                assignTaskCreator(data.playerName, data.choice);
            } else if (data.type === 'ASSIGN_CREATOR') {
                setupCreatorUI(data.targetPlayer, data.choice, data.creatorName);
            } else if (data.type === 'SHOW_TASK') {
                currentTaskText = data.taskText;
                displayTaskScreen(data.targetPlayer, data.choice, data.taskText, data.creator);
            } else if (data.type === 'SHOW_RESULT') {
                showFeedbackScreen(data.targetPlayer, data.choice, data.taskText, data.resultText);
            } else if (data.type === 'VOTE_NEXT_TURN') {
                handleNextTurnVote(data.playerName);
            } else if (data.type === 'EXECUTE_NEXT_TURN') {
                executeProceedToNextTurn();
            } else if (data.type === 'START_WHEEL') {
                document.getElementById("woP-phase").classList.add("hidden");
                document.getElementById("wheel-phase").classList.remove("hidden");
            } else if (data.type === 'SPIN_WHEEL') {
                runWheelAnimation(data.sector, data.rotation);
            } else if (data.type === 'VOTE_NEXT_ROUND') {
                handleNextRoundVote(data.playerName);
            } else if (data.type === 'NEXT_ROUND') {
                nextRound();
            } else if (data.type === 'ELIMINATE') {
                players = data.players;
                updatePlayerList();
            } else if (data.type === 'CHAT_MSG') {
                appendChat(data.sender, data.text);
            }
        }

        function updatePlayerList() {
            const list = document.getElementById("player-list");
            if (!list) return;
            list.innerHTML = "";
            players.forEach((p, index) => {
                list.innerHTML += `<li><b>${index + 1}.</b> ${p.accessory || ''} ${p.name} ${p.eliminated ? '❌' : ''}</li>`;
            });
            if (isHost && players.length >= 1) {
                document.getElementById("start-btn").classList.remove("hidden");
            }
        }

        function startOnlineGame() {
            if (!isHost) return;
            sendData({ type: 'START_GAME', players: players });
            startGameUI();
        }

        function startGameUI() {
            document.getElementById("auth-modal").classList.add("hidden");
            document.getElementById("account-modal").classList.add("hidden");
            document.getElementById("setup").classList.add("hidden");
            document.getElementById("lobby-wait-box").classList.add("hidden");
            document.getElementById("woP-phase").classList.remove("hidden");
            document.getElementById("emergency-box").classList.remove("hidden");
            document.getElementById("chat-box-container").classList.remove("hidden");
            updateWopTurn();
        }

        function updateWopTurn() {
            while (currentPlayerIndex < players.length && players[currentPlayerIndex].eliminated) {
                currentPlayerIndex++;
            }
            if (currentPlayerIndex >= players.length) {
                if (isHost) {
                    sendData({ type: 'START_WHEEL' });
                    document.getElementById("woP-phase").classList.add("hidden");
                    document.getElementById("wheel-phase").classList.remove("hidden");
                }
                return;
            }

            let currentP = players[currentPlayerIndex];
            document.getElementById("wop-turn-title").innerHTML = translations[currentLang].turnTitle + `<span style="color: var(--primary-color);">${currentP.name}</span>`;
            
            document.getElementById("wop-choice-area").classList.add("hidden");
            document.getElementById("creator-input-area").classList.add("hidden");
            document.getElementById("active-task-area").classList.add("hidden");
            document.getElementById("result-feedback-area").classList.add("hidden");
            document.getElementById("waiting-for-player-box").classList.add("hidden");

            if (currentP.name === myName) {
                document.getElementById("wop-choice-area").classList.remove("hidden");
            } else {
                document.getElementById("waiting-for-player-box").classList.remove("hidden");
                document.getElementById("waiting-info-text").innerText = (currentLang === 'de' ? `Warte, bis ${currentP.name} wählt...` : `Waiting for ${currentP.name} to choose...`);
            }
        }

        function submitWopChoice() {
            let choice = document.getElementById("wop-choice").value;
            pendingChoice = choice;
            sendData({ type: 'SUBMIT_CHOICE', playerName: myName, choice: choice });
        }

        function assignTaskCreator(targetName, choice) {
            let activeOthers = players.filter(p => !p.eliminated && p.name !== targetName);
            let creatorName = activeOthers.length > 0 ? activeOthers[Math.floor(Math.random() * activeOthers.length)].name : targetName;
            sendData({ type: 'ASSIGN_CREATOR', targetPlayer: targetName, choice: choice, creatorName: creatorName });
        }

        function setupCreatorUI(targetPlayer, choice, creatorName) {
            document.getElementById("wop-choice-area").classList.add("hidden");
            document.getElementById("waiting-for-player-box").classList.add("hidden");
            if (creatorName === myName) {
                document.getElementById("creator-input-area").classList.remove("hidden");
                document.getElementById("creator-instruction-title").innerText = (currentLang === 'de' ? "Erstelle eine Aufgabe für: " : "Create a task for: ") + targetPlayer;
            } else {
                document.getElementById("waiting-for-player-box").classList.remove("hidden");
                document.getElementById("waiting-info-text").innerText = (currentLang === 'de' ? `Warte auf ${creatorName}...` : `Waiting for ${creatorName}...`);
            }
        }

        function sendCustomTask() {
            let taskText = document.getElementById("custom-task-input").value.trim();
            if (!taskText) { alert(translations[currentLang].alertTask); return; }
            let targetPlayer = players[currentPlayerIndex].name;
            currentTaskText = taskText;
            document.getElementById("creator-input-area").classList.add("hidden");
            sendData({ type: 'SHOW_TASK', targetPlayer: targetPlayer, choice: pendingChoice, taskText: taskText, creator: myName });
        }

        function displayTaskScreen(targetPlayer, choice, taskText, creator) {
            document.getElementById("wop-choice-area").classList.add("hidden");
            document.getElementById("creator-input-area").classList.add("hidden");
            document.getElementById("waiting-for-player-box").classList.add("hidden");

            if (targetPlayer === myName) {
                document.getElementById("active-task-area").classList.remove("hidden");
                document.getElementById("task-title-text").innerText = choice === "truth" ? (currentLang === 'de' ? "💡 WAHRHEIT" : "💡 TRUTH") : (currentLang === 'de' ? "🔥 PFLICHT" : "🔥 DARE");
                document.getElementById("task-assigner-info").innerText = (currentLang === 'de' ? "Von: " : "From: ") + creator;
                document.getElementById("task-content-desc").innerText = taskText;
                
                if (choice === "truth") {
                    document.getElementById("answer-box").classList.remove("hidden");
                    document.getElementById("dare-box").classList.add("hidden");
                } else {
                    document.getElementById("answer-box").classList.add("hidden");
                    document.getElementById("dare-box").classList.remove("hidden");
                }
            } else {
                document.getElementById("waiting-for-player-box").classList.remove("hidden");
                document.getElementById("waiting-info-text").innerText = (currentLang === 'de' ? `${targetPlayer} ist dran...` : `${targetPlayer}'s turn...`);
            }
        }

        function submitAnswer() {
            let ans = document.getElementById("player-answer-input").value.trim();
            if (!ans) { alert(translations[currentLang].alertAnswer); return; }
            finishTaskAndReward();
            sendData({ type: 'SHOW_RESULT', targetPlayer: players[currentPlayerIndex].name, choice: pendingChoice, taskText: currentTaskText, resultText: (currentLang === 'de' ? `Antwort: "${ans}"` : `Answer: "${ans}"`) });
        }

        function submitDareDone() {
            finishTaskAndReward();
            sendData({ type: 'SHOW_RESULT', targetPlayer: players[currentPlayerIndex].name, choice: pendingChoice, taskText: currentTaskText, resultText: (currentLang === 'de' ? "Erfolgreich erfüllt! ✅" : "Successfully completed! ✅") });
        }

        function finishTaskAndReward() {
            let isDare = (pendingChoice === "dare");
            if (players[currentPlayerIndex].name === myName) {
                addRewards(isDare);
            }
        }

        function showFeedbackScreen(targetPlayer, choice, taskText, resultText) {
            document.getElementById("active-task-area").classList.add("hidden");
            document.getElementById("result-feedback-area").classList.remove("hidden");
            document.getElementById("feedback-player-name").innerText = (currentLang === 'de' ? `${targetPlayer} hat abgeschlossen!` : `${targetPlayer} finished!`);
            document.getElementById("feedback-task-info").innerText = (currentLang === 'de' ? `Aufgabe: "${taskText}"` : `Task: "${taskText}"`);
            document.getElementById("feedback-result-box").innerText = resultText;
            nextTurnVotedPlayers = [];
        }

        function voteNextTurn() {
            document.getElementById("next-turn-btn").disabled = true;
            sendData({ type: 'VOTE_NEXT_TURN', playerName: myName });
        }

        function handleNextTurnVote(pName) {
            if (!nextTurnVotedPlayers.includes(pName)) nextTurnVotedPlayers.push(pName);
            let activeCount = players.filter(p => !p.eliminated).length;
            document.getElementById("next-votes-count").innerText = nextTurnVotedPlayers.length;
            document.getElementById("next-votes-total").innerText = activeCount;

            if (isHost && nextTurnVotedPlayers.length >= activeCount) {
                sendData({ type: 'EXECUTE_NEXT_TURN' });
            }
        }

        function executeProceedToNextTurn() {
            document.getElementById("result-feedback-area").classList.add("hidden");
            currentPlayerIndex++;
            updateWopTurn();
        }

        function spinWheel() {
            let sectors = translations[currentLang].wheelSectors;
            let idx = Math.floor(Math.random() * sectors.length);
            currentRotation += 1800 + (idx * (360 / sectors.length));
            sendData({ type: 'SPIN_WHEEL', sector: idx, rotation: currentRotation });
        }

        function runWheelAnimation(sectorIndex, rotationVal) {
            document.getElementById("spin-btn").disabled = true;
            let wheel = document.getElementById("wheel-container");
            wheel.style.transform = `rotate(-${rotationVal}deg)`;
            setTimeout(() => {
                document.getElementById("spin-btn").disabled = false;
                let selected = translations[currentLang].wheelSectors[sectorIndex];
                wheel.innerText = (currentLang === 'de' ? "ERGEBNIS!" : "RESULT!");
                document.getElementById("wheel-action-title").innerText = selected.title;
                document.getElementById("wheel-action-desc").innerText = selected.desc;
                document.getElementById("wheel-result-box").classList.remove("hidden");
                userXP += 50; userCoins += 30; saveUserData(); updateHUD();
            }, 3000);
        }

        function voteNextRound() {
            document.getElementById("next-round-btn").disabled = true;
            sendData({ type: 'VOTE_NEXT_ROUND', playerName: myName });
        }

        function handleNextRoundVote(pName) {
            if (!nextRoundVotedPlayers.includes(pName)) nextRoundVotedPlayers.push(pName);
            let activeCount = players.filter(p => !p.eliminated).length;
            if (isHost && nextRoundVotedPlayers.length >= activeCount) sendData({ type: 'NEXT_ROUND' });
        }

        function nextRound() {
            currentPlayerIndex = 0;
            document.getElementById("wheel-result-box").classList.add("hidden");
            document.getElementById("wheel-phase").classList.add("hidden");
            document.getElementById("woP-phase").classList.remove("hidden");
            updateWopTurn();
        }

        function triggerLeak() {
            let targetName = prompt(currentLang === 'de' ? "Wer hat geleakt / aufgegeben?" : "Who leaked / gave up?");
            let target = players.find(p => p.name.toLowerCase() === targetName?.trim().toLowerCase());
            if (target) {
                target.eliminated = true;
                userStreak = 0; saveUserData(); updateHUD();
                sendData({ type: 'ELIMINATE', players: players });
                alert((currentLang === 'de' ? `❌ ${target.name} ist ausgeschieden.` : `❌ ${target.name} is eliminated.`));
            }
        }

        function sendChatMessage() {
            let input = document.getElementById("chat-input");
            if (!input.value.trim()) return;
            sendData({ type: 'CHAT_MSG', sender: myName, text: input.value.trim() });
            input.value = "";
        }

        function appendChat(sender, text) {
            let box = document.getElementById("chat-messages");
            box.innerHTML += `<div class="chat-msg"><b>${sender}:</b> ${text}</div>`;
            box.scrollTop = box.scrollHeight;
        }
    </script>
</body>
</html>
