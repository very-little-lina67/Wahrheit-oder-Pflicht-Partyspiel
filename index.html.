<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wahrheit oder Pflicht Partyspiel / Truth or Dare Party Game</title>
    <script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #111, #2b1055, #7597de);
            --container-bg: rgba(0, 0, 0, 0.6);
            --primary-color: #ff0055;
            --primary-hover: #e6004c;
            --accent-color: #00bfff;
            --text-color: #ffffff;
        }

        /* THEMES */
        body.theme-cyberpunk {
            background: linear-gradient(135deg, #050505, #ff0055, #00ffff);
            --primary-color: #00ffff;
            --primary-hover: #00cccc;
            --accent-color: #ff0055;
        }
        body.theme-retro {
            background: linear-gradient(135deg, #2c003e, #e6af2e, #ff5722);
            --primary-color: #e6af2e;
            --primary-hover: #c49420;
            --accent-color: #ff5722;
        }
        body.theme-party {
            background: linear-gradient(135deg, #1f005c, #5b0060, #870160);
            --primary-color: #ff007f;
            --primary-hover: #d9006c;
            --accent-color: #7928ca;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg-gradient);
            color: var(--text-color);
            text-align: center;
            margin: 0;
            padding: 20px;
            min-height: 100vh;
            transition: background 0.5s ease;
        }
        h1 { color: var(--primary-color); text-shadow: 0 0 10px rgba(255,0,85,0.6); }
        .container {
            max-width: 680px;
            margin: 0 auto;
            background: var(--container-bg);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.1);
        }
        input, button, select, textarea {
            padding: 12px;
            font-size: 16px;
            border-radius: 8px;
            border: none;
            margin: 8px 0;
            width: 100%;
            box-sizing: border-box;
            font-family: inherit;
        }
        input, select, textarea { background: rgba(255,255,255,0.15); color: white; }
        input::placeholder, textarea::placeholder { color: #ccc; }
        button {
            background-color: var(--primary-color);
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 15px rgba(255,0,85,0.4);
        }
        button:hover { background-color: var(--primary-hover); transform: translateY(-2px); }
        .btn-blue { background-color: var(--accent-color); color: #111; box-shadow: 0 4px 15px rgba(0,191,255,0.4); }
        .btn-blue:hover { opacity: 0.9; }
        .btn-green { background-color: #28a745; color: white; box-shadow: 0 4px 15px rgba(40,167,69,0.4); }
        .btn-green:hover { background-color: #218838; }
        .btn-danger { background-color: #ff3300; box-shadow: 0 4px 15px rgba(255,51,0,0.5); }
        .hidden { display: none !important; }
        
        /* MODALS */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            overflow-y: auto;
            padding: 10px;
        }
        .modal-content {
            background: rgba(20, 20, 30, 0.95);
            padding: 25px;
            border-radius: 20px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.9);
            border: 2px solid var(--primary-color);
            text-align: left;
            max-height: 90vh;
            overflow-y: auto;
        }

        #wheel-container {
            position: relative;
            width: 260px;
            height: 260px;
            margin: 20px auto;
            border-radius: 50%;
            border: 8px solid var(--accent-color);
            display: flex;
            align-items: center;
            justify-content: center;
            background: #111;
            font-weight: bold;
            font-size: 15px;
            padding: 15px;
            box-shadow: 0 0 25px rgba(0, 191, 255, 0.6);
            transition: transform 3s cubic-bezier(0.15, 0.9, 0.2, 1);
            text-align: center;
            box-sizing: border-box;
        }
        .pointer {
            width: 0; height: 0; 
            border-left: 15px solid transparent;
            border-right: 15px solid transparent;
            border-bottom: 30px solid #ffcc00;
            margin: 0 auto;
            position: relative;
            top: 10px;
            z-index: 10;
        }
        .box-section {
            background: rgba(255,255,255,0.05);
            padding: 15px;
            border-radius: 10px;
            margin-top: 15px;
            border-left: 5px solid var(--primary-color);
            text-align: left;
        }

        #chat-box-container {
            margin-top: 25px;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 10px;
            padding: 12px;
            border-top: 3px solid var(--primary-color);
            border-left: 5px solid var(--primary-color);
            border-right: 1px solid rgba(255,255,255,0.1);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-align: left;
        }
        #chat-messages {
            height: 110px;
            overflow-y: auto;
            font-size: 13px;
            margin-bottom: 8px;
            background: rgba(0,0,0,0.3);
            padding: 8px;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .chat-msg { word-break: break-word; }

        .hud-bar {
            display: flex;
            justify-content: space-between;
            background: rgba(0,0,0,0.5);
            padding: 10px 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 14px;
            border: 1px solid rgba(255,255,255,0.1);
            flex-wrap: wrap;
            gap: 5px;
        }
        .shop-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }
        .shop-item {
            background: rgba(255,255,255,0.08);
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .avatar-preview-box {
            position: relative;
            font-size: 40px;
            width: 70px;
            height: 70px;
            background: #222;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px auto;
            border: 2px solid var(--accent-color);
        }
        .badge-tag {
            display: inline-block;
            background: rgba(255,204,0,0.2);
            color: #ffcc00;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 12px;
            margin: 3px;
            border: 1px solid #ffcc00;
        }
    </style>
</head>
<body class="theme-default">

    <!-- LOGIN & AUTH MODAL -->
    <div id="auth-modal" class="modal-overlay">
        <div class="modal-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h2 id="ui-auth-title" style="color: var(--primary-color); margin: 0;">User Account & Vibe</h2>
                <div>
                    <select id="auth-lang-select" onchange="changeLanguage()" style="padding: 4px; font-size: 13px; width: auto; margin:0;">
                        <option value="de">Deutsch</option>
                        <option value="en">English</option>
                    </select>
                </div>
            </div>
            <p id="ui-auth-desc" style="font-size: 13px; color: #bbb; text-align: center; margin-bottom: 20px;">Log in to use your XP, coins and the shop!</p>
            
            <label id="ui-label-email" style="font-size: 13px; color: #ccc;">Email Address:</label>
            <input type="email" id="auth-email" placeholder="name@example.com (Master: master@vibe.party)">
            
            <label id="ui-label-username" style="font-size: 13px; color: #ccc; margin-top: 10px; display: block;">Username:</label>
            <input type="text" id="auth-username" placeholder="Your Player Name">

            <label id="ui-label-pass" style="font-size: 13px; color: #ccc; margin-top: 10px; display: block;">Password:</label>
            <input type="password" id="auth-password" placeholder="Your secure password">
            
            <div style="display: flex; gap: 10px; margin-top: 15px;">
                <button id="ui-btn-register" class="btn-green" onclick="registerUser()">Register</button>
                <button id="ui-btn-login" class="btn-blue" onclick="loginUser()">Log In</button>
            </div>
        </div>
    </div>

    <!-- SHOP & PROFILE MODAL -->
    <div id="account-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h2 id="ui-shop-head" style="color: var(--accent-color); margin-top: 0; text-align: center;">👤 Profile & Vibe Shop</h2>
            
            <div style="text-align: center; margin-bottom: 15px;">
                <div class="avatar-preview-box" id="avatar-display">😎<span id="equipped-accessory" style="position: absolute; font-size: 25px; top: -5px; right: -5px;"></span></div>
                <strong id="acc-display-name" style="color: #ffcc00; font-size: 18px;"></strong> <span id="acc-display-role" style="background:#ff3300; padding:2px 6px; border-radius:4px; font-size:11px; font-weight:bold;"></span><br>
                <span id="acc-display-level" style="font-size: 13px; color: #00bfff;"></span> | 💰 <span id="acc-display-coins" style="color: #ffcc00;">0</span> <span id="ui-coins-text">Coins</span>
            </div>

            <div class="box-section" style="margin-top:0;">
                <h4 id="ui-badges-head" style="margin: 0 0 10px 0; color: var(--primary-color);">🏆 Your Badges & Trophies</h4>
                <div id="badge-container"></div>
            </div>

            <div class="box-section">
                <h4 id="ui-accessories-head" style="margin: 0 0 10px 0; color: var(--accent-color);">🛍️ Avatar Accessories</h4>
                <div class="shop-grid">
                    <div class="shop-item">
                        <div>👑 <span id="ui-item-crown">Crown</span> (150 Coins)</div>
                        <button class="btn-blue shop-action-btn" style="padding:6px; font-size:12px; margin-top:5px;" onclick="buyItem('crown', 150, '👑')">Buy / Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🕶️ <span id="ui-item-glasses">Sunglasses</span> (100 Coins)</div>
                        <button class="btn-blue shop-action-btn" style="padding:6px; font-size:12px; margin-top:5px;" onclick="buyItem('glasses', 100, '🕶️')">Buy / Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🎩 <span id="ui-item-hat">Party Hat</span> (120 Coins)</div>
                        <button class="btn-blue shop-action-btn" style="padding:6px; font-size:12px; margin-top:5px;" onclick="buyItem('hat', 120, '🎩')">Buy / Equip</button>
                    </div>
                    <div class="shop-item">
                        <div>🧔 <span id="ui-item-beard">Mustache</span> (80 Coins)</div>
                        <button class="btn-blue shop-action-btn" style="padding:6px; font-size:12px; margin-top:5px;" onclick="buyItem('beard', 80, '🧔')">Buy / Equip</button>
                    </div>
                </div>
            </div>

            <div class="box-section">
                <h4 id="ui-themes-head" style="margin: 0 0 10px 0; color: var(--primary-color);">🎨 Color Themes</h4>
                <div class="shop-grid">
                    <div class="shop-item">
                        <div>Cyberpunk (200 Coins)</div>
                        <button class="btn-green theme-action-btn" style="padding:6px; font-size:12px; margin-top:5px;" onclick="buyTheme('theme-cyberpunk', 200)">Unlock</button>
                    </div>
                    <div class="shop-item">
                        <div>Retro-Pixel (200 Coins)</div>
                        <button class="btn-green theme-action-btn" style="padding:6px; font-size:12px; margin-top:5px;" onclick="buyTheme('theme-retro', 200)">Unlock</button>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 10px; margin-top: 15px;">
                <button id="ui-btn-logout" class="btn-danger" onclick="logoutUser()" style="flex: 1;">Logout</button>
                <button id="ui-btn-close" class="btn-blue" onclick="closeAccountModal()" style="flex: 1;">Close</button>
            </div>
        </div>
    </div>

    <!-- FEEDBACK MODAL -->
    <div id="feedback-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h2 id="ui-fb-title" style="color: var(--primary-color); margin-top:0;">📝 Bug melden / Feedback</h2>
            <p id="ui-fb-desc" style="font-size: 13px; color: #ccc;">Teile Bugs oder Verbesserungsvorschläge direkt mit den Admins und dem Master!</p>
            
            <label id="ui-fb-type-label" style="font-size:13px; color:#ccc;">Art des Feedbacks:</label>
            <select id="feedback-type">
                <option value="bug" id="ui-fb-opt-bug">🐛 Bug / Fehler</option>
                <option value="improvement" id="ui-fb-opt-imp">💡 Verbesserung / Feature-Wunsch</option>
            </select>

            <label id="ui-fb-msg-label" style="font-size:13px; color:#ccc; margin-top:10px; display:block;">Nachricht:</label>
            <textarea id="feedback-text-input" rows="4" placeholder="Beschreibe den Bug oder deine Idee..."></textarea>

            <div style="display: flex; gap: 10px; margin-top: 15px;">
                <button class="btn-green" onclick="submitFeedback()" id="ui-fb-send-btn" style="flex:1;">Absenden</button>
                <button class="btn-blue" onclick="document.getElementById('feedback-modal').classList.add('hidden')" id="ui-fb-close-btn" style="flex:1;">Schließen</button>
            </div>
        </div>
    </div>

    <!-- ADMIN PANEL MODAL -->
    <div id="admin-modal" class="modal-overlay hidden">
        <div class="modal-content" style="max-width: 650px;">
            <h2 style="color: #ff3300; margin-top:0;">🛡️ Admin & Moderation Panel</h2>
            <p style="font-size: 13px; color: #ccc;">Verwalte Benutzer, Rollen und eingereichtes Feedback (Bugs & Verbesserungen).</p>
            
            <div class="box-section" style="max-height: 200px; overflow-y: auto;">
                <h4 style="margin:0 0 8px 0; color:var(--accent-color);">👥 Registrierte Benutzer:</h4>
                <div id="admin-user-list"></div>
            </div>

            <div class="box-section" style="max-height: 200px; overflow-y: auto;">
                <h4 style="margin:0 0 8px 0; color:var(--primary-color);">📥 Eingegangenes Feedback & Bugs:</h4>
                <div id="admin-feedback-list"></div>
            </div>

            <div style="margin-top: 15px; display: flex; gap: 10px;">
                <button class="btn-blue" onclick="document.getElementById('admin-modal').classList.add('hidden')" style="flex:1;">Schließen</button>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- SPIELER HUD (XP, COINS, STREAK) -->
        <div class="hud-bar">
            <div>🔥 <span id="ui-hud-streak-text">Streak</span>: <span id="hud-streak" style="color: #ffcc00; font-weight:bold;">0</span></div>
            <div>✨ XP: <span id="hud-xp" style="color: #00bfff; font-weight:bold;">0</span></div>
            <div>💰 <span id="ui-hud-coins-text">Coins</span>: <span id="hud-coins" style="color: #ffcc00; font-weight:bold;">0</span></div>
            <div style="display:flex; gap:4px; flex-wrap:wrap;">
                <button id="btn-admin-panel" class="btn-danger hidden" onclick="openAdminModal()" style="padding:2px 6px; font-size:11px; margin:0;">🛡️ Admin</button>
                <button id="ui-btn-feedback" class="btn-green" onclick="openFeedbackModal()" style="padding:2px 6px; font-size:11px; margin:0;">📝 Feedback</button>
                <button id="ui-btn-shop" class="btn-blue" onclick="openAccountModal()" style="padding:2px 6px; font-size:11px; margin:0;">🛒 Shop</button>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; align-items: center; margin-bottom: 10px;">
            <div>
                <label for="lang-select" style="font-size: 13px; color: #ccc;">🌐 <span id="ui-lang-label-text">Language</span>:</label>
                <select id="lang-select" onchange="changeLanguageFromApp()" style="width: auto; padding: 5px; font-size: 14px; display: inline-block;">
                    <option value="de">Deutsch</option>
                    <option value="en">English</option>
                </select>
            </div>
        </div>

        <h1 id="ui-title">Wahrheit oder Pflicht Partyspiel 🍻🚻</h1>
        <p id="ui-subtitle">Spielt nacheinander Wahrheit oder Pflicht. Nach jeder vollen Runde dreht sich das Rad für alle!</p>

        <!-- SETUP (LOBBY) -->
        <div id="setup" class="box-section hidden">
            <h3 id="ui-setup-head">Online Lobby:</h3>

            <button onclick="hostGame()" id="ui-host-btn" style="margin-top: 5px;">Create Lobby (Host) 🏠</button>
            <hr style="border-color: rgba(255,255,255,0.1); margin: 15px 0;">
            <input type="text" id="lobby-code-input" placeholder="Enter lobby code...">
            <button class="btn-blue" onclick="joinGame()" id="ui-join-btn">Join Lobby 🚀</button>
        </div>

        <!-- LOBBY WARTESAAL -->
        <div id="lobby-wait-box" class="hidden box-section" style="text-align: center;">
            <h3 id="ui-lobby-code-title">Lobby Code: <span id="display-code" style="color: #ffcc00; font-size: 22px;"></span></h3>
            <p id="ui-share-code">Share this code with your fellow players!</p>
            <ul id="player-list" style="list-style: none; padding: 0; text-align: left;"></ul>
            <button id="start-btn" class="hidden" onclick="startOnlineGame()">Start Game! 🔥</button>
            <div id="client-wait-msg" class="hidden" style="color: #ffcc00;">Connected to lobby! Waiting for host to start...</div>
        </div>

        <!-- WAHRHEIT ODER PFLICHT PHASE -->
        <div id="woP-phase" class="hidden">
            <h2 id="wop-turn-title">Current Turn: </h2>
            
            <div class="box-section" id="wop-choice-area">
                <label id="ui-choice-label">What do you choose?</label>
                <select id="wop-choice">
                    <option value="truth" id="ui-opt-truth">Truth (+XP / +10 Coins)</option>
                    <option value="dare" id="ui-opt-dare">Dare (+XP / +20 Coins)</option>
                </select>
                <div style="display: flex; gap: 10px;">
                    <button onclick="submitWopChoice()" id="ui-select-btn" style="flex:2;">Select 🎲</button>
                    <button class="btn-blue" onclick="useJoker()" id="ui-joker-btn" style="flex:1; background:#9c27b0; color:white;">🃏 Joker (-30 Coins)</button>
                </div>
            </div>

            <div class="box-section hidden" id="creator-input-area" style="border-left-color: #ffcc00;">
                <h3 id="creator-instruction-title" style="color: #ffcc00;"></h3>
                <p id="creator-target-info" style="font-size: 14px; color: #ccc;"></p>
                <input type="text" id="custom-task-input" placeholder="Type your question or dare here...">
                <button class="btn-blue" onclick="sendCustomTask()" id="ui-send-task-btn">Send to player 🚀</button>
            </div>

            <div class="box-section hidden" id="active-task-area" style="border-left-color: var(--accent-color);">
                <h3 id="task-title-text" style="color: var(--accent-color);"></h3>
                <p style="font-size: 13px; color: #ffcc00;" id="task-assigner-info"></p>
                <p id="task-content-desc" style="font-size: 18px; font-weight: bold; background: rgba(0,0,0,0.3); padding: 10px; border-radius: 6px;"></p>
                
                <div id="answer-box" class="hidden" style="margin-top: 10px;">
                    <label id="ui-answer-label">Your Answer:</label>
                    <textarea id="player-answer-input" rows="2" placeholder="Type your answer here..."></textarea>
                    <button class="btn-green" onclick="submitAnswer()" style="margin-top: 10px;" id="ui-submit-answer-btn">✅ Submit Answer</button>
                </div>

                <div id="dare-box" class="hidden" style="margin-top: 10px;">
                    <button class="btn-green" onclick="submitDareDone()" style="margin-top: 10px;" id="ui-dare-done-btn">✅ Dare completed & confirm!</button>
                </div>
            </div>

            <div class="box-section hidden" id="result-feedback-area" style="border-left-color: #28a745; text-align: center;">
                <h3 id="ui-done-head" style="color: #28a745;">🎉 Done!</h3>
                <p id="feedback-player-name" style="font-weight: bold; font-size: 16px; color: #ffcc00;"></p>
                <p id="feedback-task-info" style="font-style: italic; color: #ccc;"></p>
                <div id="feedback-result-box" style="background: rgba(0,0,0,0.4); padding: 12px; border-radius: 8px; font-size: 18px; margin: 10px 0;"></div>
                
                <button class="btn-blue" id="next-turn-btn" onclick="voteNextTurn()" style="margin-top: 10px;">➡️ Next</button>
                <p id="waiting-next-msg" style="color: var(--accent-color); font-size: 14px; margin-top: 8px;"><span id="ui-waiting-other">Waiting for other players...</span> (<span id="next-votes-count">0</span>/<span id="next-votes-total">0</span>)</p>
            </div>

            <div class="box-section hidden" id="waiting-for-player-box" style="border-left-color: #666;">
                <p id="waiting-info-text" style="color: #ccc; font-weight: bold;"></p>
            </div>

            <div id="wop-status-info" style="margin-top: 15px; font-size: 14px; color: #ffcc00;"></div>
        </div>

        <!-- GLÜCKSRAD -->
        <div id="wheel-phase" class="hidden">
            <h2 id="ui-wheel-head" style="color: var(--accent-color);">🎡 WHEEL MODE: Everyone acts!</h2>
            <p id="ui-wheel-desc">Everyone played truth or dare. Now the wheel of fate spins for everyone!</p>
            
            <div class="pointer"></div>
            <div id="wheel-container">Wheel ready!</div>
            
            <button onclick="spinWheel()" id="spin-btn" class="btn-blue">Spin the wheel now 🎡</button>
            
            <div id="wheel-result-box" class="box-section hidden" style="border-left-color: var(--accent-color); text-align: center;">
                <h3 id="wheel-action-title" style="color: #ffcc00;"></h3>
                <p id="wheel-action-desc"></p>
                
                <button id="next-round-btn" onclick="voteNextRound()" class="btn-blue" style="margin-top: 10px;">➡️ Next Round!</button>
                <p id="waiting-round-msg" style="color: var(--accent-color); font-size: 14px; margin-top: 8px;"><span id="ui-waiting-other-round">Waiting for other players...</span> (<span id="round-votes-count">0</span>/<span id="round-votes-total">0</span>)</p>
            </div>
        </div>

        <!-- LIVE CHAT BEREICH -->
        <div id="chat-box-container" class="hidden">
            <div id="chat-messages"></div>
            <div style="display: flex; gap: 5px;">
                <input type="text" id="chat-input" placeholder="Type a message..." style="margin:0;" onkeydown="if(event.key === 'Enter') sendChatMessage()">
                <button class="btn-blue" style="width: 80px; margin:0; padding:8px;" onclick="sendChatMessage()" id="ui-chat-send">Send</button>
            </div>
        </div>

