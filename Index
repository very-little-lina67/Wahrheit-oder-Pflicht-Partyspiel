            <ul id="player-list" style="list-style: none; padding: 0; text-align: left; font-size: 13px;"></ul>

            <!-- Pass & Play: jeder Mitspieler kann lokale Sitze auf SEINEM Gerät hinzufügen -->
            <div id="local-players-box" class="hidden" style="margin: 10px 0; padding: 10px; background: rgba(56,189,248,0.08); border-radius: 10px; border: 1px solid rgba(56,189,248,0.3); text-align: left;">
                <p id="ui-local-players-desc" style="font-size:12px; color:#a5f3fc; margin:0 0 8px 0;">📱 Mitspieler ohne Gerät? Namen hier hinzufügen – nur du steuerst diese Sitze auf deinem Gerät.</p>
                <div style="display:flex; gap:6px; align-items:center;">
                    <input type="text" id="local-player-name-input" maxlength="20" placeholder="Name des Mitspielers" style="flex:1; font-size:13px; padding:8px; margin:0;">
                    <button type="button" class="btn-blue" id="ui-add-local-player-btn" onclick="addLocalPlayer()" style="width:auto; padding:8px 12px; font-size:12px; margin:0;">+ Hinzufügen</button>
                </div>
            </div>

            <!-- Host: Mitspieler-Suche an/aus -->
            <div id="looking-toggle-box" class="hidden" style="margin: 10px 0; padding: 8px; background: rgba(255,204,0,0.08); border-radius: 8px; border: 1px solid rgba(255,204,0,0.25);">
                <label style="display:flex; align-items:center; justify-content:center; gap:8px; font-size:13px; cursor:pointer;">
                    <input type="checkbox" id="looking-for-players-cb" onchange="toggleLookingForPlayers(this.checked)" style="width:auto; margin:0;">
                    <span id="ui-looking-toggle-label">🔍 Mitspieler gesucht (öffentlich sichtbar)</span>
                </label>
            </div>

            <button id="start-btn" class="hidden" onclick="startOnlineGame()" style="font-size: 14px; padding: 10px;">Spiel starten! 🔥</button>
            <div id="client-wait-msg" class="hidden" style="color: #ffcc00; font-size: 12px;">Mit Lobby verbunden! Warte darauf, dass der Host startet...</div>
        </div>

        <!-- WAHRHEIT ODER PFLICHT PHASE -->
        <div id="woP-phase" class="hidden">
            <h2 id="wop-turn-title" style="font-size: 1.2rem;">Current Turn: </h2>
            
            <div class="box-section" id="wop-choice-area">
                <label id="ui-choice-label" style="font-size: 13px;">What do you choose?</label>
                <select id="wop-choice" style="font-size: 13px; padding: 8px;">
                    <option value="truth" id="ui-opt-truth">Truth (+XP / +4 Coins)</option>
                    <option value="dare" id="ui-opt-dare">Dare (+XP / +8 Coins)</option>
                </select>
                <div>
                    <button onclick="submitWopChoice()" id="ui-select-btn" style="width: 100%; font-size: 14px; padding: 10px;">Select 🎲</button>
                </div>
            </div>

            <div class="box-section hidden" id="creator-input-area" style="border-left-color: #ffcc00;">
                <h3 id="creator-instruction-title" style="color: #ffcc00; font-size: 14px; margin-top:0;"></h3>
                <p id="creator-target-info" style="font-size: 12px; color: #ccc;"></p>
                <input type="text" id="custom-task-input" placeholder="Type your question or dare here..." style="font-size: 13px; padding: 8px;">
                <button class="btn-blue" onclick="sendCustomTask()" id="ui-send-task-btn" style="font-size: 13px; padding: 8px;">Send to player 🚀</button>
            </div>

            <div class="box-section hidden" id="active-task-area" style="border-left-color: var(--accent-color);">
                <h3 id="task-title-text" style="color: var(--accent-color); font-size: 14px; margin-top:0;"></h3>
                <p style="font-size: 12px; color: #ffcc00;" id="task-assigner-info"></p>
                <p id="task-content-desc" style="font-size: 15px; font-weight: bold; background: rgba(0,0,0,0.3); padding: 8px; border-radius: 6px;"></p>
                
                <div id="answer-box" class="hidden" style="margin-top: 8px;">
                    <label id="ui-answer-label" style="font-size: 12px;">Your Answer:</label>
                    <textarea id="player-answer-input" rows="2" placeholder="Type your answer here..." style="font-size: 13px;"></textarea>
                    <button class="btn-green" onclick="submitAnswer()" style="margin-top: 6px; font-size: 13px; padding: 8px;" id="ui-submit-answer-btn">✅ Submit Answer</button>
                </div>

                <div id="dare-box" class="hidden" style="margin-top: 8px;">
                    <button class="btn-green" onclick="submitDareDone()" style="margin-top: 6px; font-size: 13px; padding: 8px;" id="ui-dare-done-btn">✅ Dare completed & confirm!</button>
                </div>

                <!-- Skip-Joker: eigene Aufgabe überspringen -->
                <div id="joker-skip-box" class="hidden" style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed rgba(255,204,0,0.35);">
                    <button class="btn-blue" onclick="useSkipJoker()" id="ui-joker-skip-btn" style="width:100%; font-size: 12px; padding: 8px; background: linear-gradient(135deg,#5b21b6,#7c3aed);">
                        🃏 <span id="ui-joker-skip-btn-text">Aufgabe überspringen</span> (<span id="joker-skip-btn-count">0</span>)
                    </button>
                </div>
            </div>

            <div class="box-section hidden" id="result-feedback-area" style="border-left-color: #28a745; text-align: center;">
                <h3 id="ui-done-head" style="color: #28a745; font-size: 14px; margin-top:0;">🎉 Done!</h3>
                <p id="feedback-player-name" style="font-weight: bold; font-size: 14px; color: #ffcc00;"></p>
                <p id="feedback-task-info" style="font-style: italic; color: #ccc; font-size: 12px;"></p>
                <div id="feedback-result-box" style="background: rgba(0,0,0,0.4); padding: 10px; border-radius: 8px; font-size: 15px; margin: 8px 0;"></div>
                
                <button class="btn-blue" id="next-turn-btn" disabled onclick="voteNextTurn()" style="margin-top: 8px; font-size: 13px; padding: 8px;">✅ Ich bestätige</button>
                <p id="waiting-next-msg" style="color: var(--accent-color); font-size: 12px; margin-top: 6px;"><span id="ui-waiting-other">Warte auf die Bestätigungen aller aktiven Spieler…</span> (<span id="next-votes-count">0</span>/<span id="next-votes-total">0</span>)</p>
            </div>

            <div class="box-section hidden" id="waiting-for-player-box" style="border-left-color: #666;">
                <p id="waiting-info-text" style="color: #ccc; font-weight: bold; font-size: 13px; margin:0;"></p>
                <!-- Force-Skip-Joker: aktuellen Spieler aussetzen -->
                <div id="joker-force-box" class="hidden" style="margin-top: 10px;">
                    <button class="btn-joker-force" onclick="useForceSkipJoker()" id="ui-joker-force-btn" style="width:100%; font-size: 12px; padding: 8px;">
                        🚫 <span id="ui-joker-force-btn-text">Spieler aussetzen</span> (<span id="joker-force-btn-count">0</span>)
                    </button>
                </div>
            </div>

            <div id="wop-status-info" style="margin-top: 10px; font-size: 13px; color: #ffcc00;"></div>
        </div>

        <!-- GLÜCKSRAD -->
        <div id="wheel-phase" class="hidden">
            <h2 id="ui-wheel-head" style="color: var(--accent-color); font-size: 1.2rem;">🎡 WHEEL MODE: Everyone acts!</h2>
            <p id="ui-wheel-desc" style="font-size: 12px;">Everyone played truth or dare. Now the wheel spins for everyone!</p>
            
            <div class="pointer"></div>
            <div id="wheel-container">Wheel ready!</div>
            
            <button onclick="spinWheel()" id="spin-btn" class="btn-blue" style="font-size: 14px; padding: 10px;">Spin the wheel now 🎡</button>
            
            <div id="wheel-result-box" class="box-section hidden" style="border-left-color: var(--accent-color); text-align: center;">
                <h3 id="wheel-action-title" style="color: #ffcc00; font-size: 14px; margin-top:0;"></h3>
                <p id="wheel-action-desc" style="font-size: 12px;"></p>
                
                <button id="next-round-btn" onclick="voteNextRound()" class="btn-blue" style="margin-top: 8px; font-size: 13px; padding: 8px;">➡️ Next Round!</button>
                <p id="waiting-round-msg" style="color: var(--accent-color); font-size: 12px; margin-top: 6px;"><span id="ui-waiting-other-round">Warte auf die Bestätigungen der anderen Spieler...</span> (<span id="round-votes-count">0</span>/<span id="round-votes-total">0</span>)</p>
            </div>
        </div>

        <!-- LIVE CHAT BEREICH -->
        <div id="chat-box-container" class="hidden">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <h4 id="ui-chat-head" style="margin:0; font-size:14px; color:var(--accent-color);">💬 Live-Chat</h4>
            </div>
            <div id="chat-messages"></div>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                    <label id="ui-chat-to-label" for="chat-recipient" style="font-size: 12px; color: #aaa; white-space: nowrap;">An:</label>
                    <select id="chat-recipient" style="flex: 1; min-width: 120px; font-size: 13px; padding: 8px; margin: 0;">
                        <option value="all" id="ui-chat-to-all">🌐 Alle (öffentlich)</option>
                    </select>
                </div>
                <div style="display: flex; gap: 6px;">
                    <input type="text" id="chat-input" placeholder="Type a message..." style="margin:0; font-size: 14px; padding: 10px;" onkeydown="if(event.key === 'Enter') sendChatMessage()">
                    <button class="btn-blue" style="width: 80px; margin:0; padding:10px; font-size: 13px; font-weight:600;" onclick="sendChatMessage()" id="ui-chat-send">Send</button>
                </div>
            </div>
        </div>

        <!-- SPIELER-STATUS (unter dem Chat) – nur Anzeige, Einstellen per Button -->
        <div id="player-status-panel" class="box-section hidden" style="margin-top:12px;padding:10px;text-align:left;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; gap:8px; flex-wrap:wrap;">
                <h4 id="status-panel-title" style="margin:0; font-size:14px;">📊 Spieler-Status</h4>
                <button id="ui-btn-status-settings" class="btn-blue" onclick="openStatusSettingsModal()" style="padding:5px 10px; font-size:12px; width:auto; margin:0;">⚙️ Status einstellen</button>
            </div>
            <div id="player-status-list" style="display:grid;gap:8px;"></div>
        </div>

    <!-- STATUS-EINSTELLUNGEN MODAL (eigene Slider) -->
    <div id="status-settings-modal" class="modal-overlay hidden">
        <div class="modal-content" style="max-width:420px;">
            <h2 id="ui-status-settings-title" style="color: var(--accent-color); margin-top:0; font-size:1.2rem;">⚙️ Mein Status einstellen</h2>
            <p id="ui-status-settings-desc" style="font-size:12px; color:#ccc; margin:0 0 12px 0;">Stelle deine aktuellen Werte ein – sie werden live an die Lobby gesendet.</p>

            <div style="font-size:12px;margin-bottom:10px;">
                <label id="ui-toilet-label" for="toilet-level">💧 Blasenfüllstand / Pipi: <span id="toilet-level-value">0%</span></label>
                <input id="toilet-level" type="range" min="0" max="100" value="0" step="10" oninput="updateOwnStatusPreview()" onchange="publishOwnStatus()" style="width:100%;">
            </div>
            <div style="font-size:12px;margin-bottom:10px;">
                <label id="ui-horny-label" for="horny-level">🔥 Horny-Level: <span id="horny-level-value">0%</span></label>
                <input id="horny-level" type="range" min="0" max="100" value="0" step="10" oninput="updateOwnStatusPreview()" onchange="publishOwnStatus()" style="width:100%;">
            </div>
            <div style="font-size:12px;margin-bottom:10px;">
                <label id="ui-alcohol-label" for="alcohol-level">🍺 Alkohol-Pegel: <span id="alcohol-level-value">0%</span></label>
                <input id="alcohol-level" type="range" min="0" max="100" value="0" step="10" oninput="updateOwnStatusPreview()" onchange="publishOwnStatus()" style="width:100%;">
            </div>
            <div style="font-size:12px;margin-bottom:10px;">
                <label id="ui-thirst-label" for="thirst-level">💧 Durst: <span id="thirst-level-value">0%</span></label>
                <input id="thirst-level" type="range" min="0" max="100" value="0" step="10" oninput="updateOwnStatusPreview()" onchange="publishOwnStatus()" style="width:100%;">
            </div>
            <div style="font-size:12px;margin-bottom:12px;">
                <label id="ui-energy-label" for="energy-level">😴 Müdigkeit: <span id="energy-level-value">0%</span></label>
                <input id="energy-level" type="range" min="0" max="100" value="0" step="10" oninput="updateOwnStatusPreview()" onchange="publishOwnStatus()" style="width:100%;">
            </div>

            <button id="ui-status-settings-close" class="btn-blue" onclick="closeStatusSettingsModal()" style="width:100%; padding:10px; font-size:13px;">Schließen</button>
        </div>
    </div>

        <!-- NOTFALL BUTTON -->
        <div id="emergency-box" class="hidden" style="margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 10px;">
            <p id="ui-emergency-desc" style="font-size: 12px; color: #ff9999;">Anyone who caves or leaks loses immediately!</p>
            <button onclick="triggerLeak()" class="btn-danger btn-leak" id="ui-leak-btn" style="font-size: 12px; padding: 8px;">🚨 I leaked / had to pee (Lost!)</button>
            <!-- Admin/Master: Spieler kicken (auch im Zuschauermodus) -->
            <button onclick="adminKickPlayer()" class="btn-admin-kick hidden" id="ui-admin-kick-btn" style="font-size: 12px; padding: 8px; margin-top: 8px;">🛡️ Spieler kicken (Admin)</button>
        </div>

        <!-- Discord Kontakt / Online-Status -->
        <div class="discord-contact-card discord-contact-card--page" id="discord-card-page">
            <div class="discord-contact-left">
                <div class="discord-contact-icon" aria-hidden="true">💬</div>
                <div class="discord-contact-meta">
                    <div class="discord-contact-title" id="ui-discord-card-title">Discord Support</div>
                    <div class="discord-contact-sub" id="ui-discord-card-sub">Fragen zum Spiel? Schreib mir auf Discord.</div>
                </div>
            </div>
            <div class="discord-contact-right">
                <span id="discord-status-footer" class="discord-status-badge discord-status-unknown" title="Discord-Status">
                    <span class="discord-status-dot"></span>
                    <span id="discord-status-footer-text">…</span>
                </span>
                <a id="ui-footer-discord" class="discord-contact-btn" href="https://discord.com/users/1098681560426881096" target="_blank" rel="noopener noreferrer">Profil öffnen</a>
            </div>
        </div>
        <p id="ui-footer-discord-hint" class="discord-contact-hint">Status aktualisiert sich automatisch. <span class="ds-online">Grün = online</span> · <span class="ds-idle">Gelb = abwesend</span> · <span class="ds-dnd">Rot = bitte nicht stören</span> · <span class="ds-offline">Grau = offline</span>.</p>

        <!-- Rechtliche Links -->
        <div id="legal-footer" class="legal-footer-safe">
            <a id="ui-footer-rules" href="regelwerk.html">Regelwerk</a>
            <span class="legal-sep">·</span>
            <a id="ui-footer-imprint" href="impressum.html">Impressum</a>
            <span class="legal-sep">·</span>
            <a id="ui-footer-privacy" href="datenschutz.html">Datenschutz</a>
        </div>
        <div class="bottom-nav-spacer" aria-hidden="true"></div>
    </div>

    <!-- Ausgelagerte Spiellogik, Firebase-Sync & Client-Interaktionen -->
    <script src="js/app.js"></script>
    <script>
      // Service Worker registrieren → Chrome zeigt „App installieren“ statt nur Verknüpfung
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("./sw.js").catch(function (err) {
            console.warn("Service Worker Registration:", err);
          });
        });
      }
    </script>

    <!-- Untere Navigation (eigene Seiten) -->
    <nav id="app-bottom-nav" class="app-bottom-nav" aria-label="Hauptmenü">
        <button type="button" class="app-nav-btn app-nav-btn-friends" id="ui-btn-friends" onclick="openFriendsModal()">
            <span class="app-nav-icon">👥</span>
            <span class="app-nav-label app-nav-label-stack" id="ui-btn-friends-label">
                <span class="app-nav-label-main">Freunde</span>
                <span class="app-nav-label-sub" id="ui-btn-friends-sub">+ online</span>
            </span>
            <span id="hud-friend-req-badge" class="hud-badge-count app-nav-badge" style="display:none;">0</span>
        </button>
        <button type="button" class="app-nav-btn" id="ui-btn-messages" onclick="openDmInbox()">
            <span class="app-nav-icon">💬</span>
            <span class="app-nav-label" id="ui-btn-messages-label">Chat</span>
            <span id="hud-dm-badge" class="hud-badge-count app-nav-badge" style="display:none;">0</span>
        </button>
        <button type="button" class="app-nav-btn" id="ui-btn-profile" onclick="openProfileModal()">
            <span class="app-nav-icon">👤</span>
            <span class="app-nav-label" id="ui-btn-profile-label">Profil</span>
        </button>
        <button type="button" class="app-nav-btn" id="ui-btn-shop" onclick="openAccountModal()">
            <span class="app-nav-icon">🛒</span>
            <span class="app-nav-label" id="ui-btn-shop-label">Shop</span>
        </button>
    </nav>

</body>
</html>
